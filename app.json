{
  "expo": {
    "name": "Notes FFS",
    "slug": "mobile-ndf",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "permissions": [
        "INTERNET"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
